{% extends "base.html.twig" %}

{% block title %}
	Photos | Ganache &amp; Cabosse | Rethel
{% endblock %}

{% block body %}
	<section class="position-relative z-index-1 padding-top-lg padding-bottom-lg">
		<div class="container max-width-adaptive-lg">
			<div class="margin-bottom-md">
				<nav class="breadcrumbs text-sm" aria-label="Breadcrumbs">
					<ol class="flex flex-wrap gap-xxs">
						<li class="breadcrumbs__item">
							<a href="{{ path('homepage') }}" class="color-inherit">Accueil</a>
							<svg class="icon margin-left-xxxs color-contrast-medium" aria-hidden="true" viewbox="0 0 16 16">
								<g stroke-width="1" stroke="currentColor">
									<polyline fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" points="6.5,3.5 11,8 6.5,12.5 "></polyline>
								</g>
							</svg>
						</li>
						<li class="breadcrumbs__item" aria-current="page">Photos</li>
					</li>
				</ol>
			</nav>
		</div>

		<div class="adv-gallery-v3">
			<ul class="grid gap-xs">
				<li class="col-4@md col-3@lg">
					<p class="adv-gallery-v3__title"></p>
				</li>

				<li class="col-8@md col-6@lg reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
					<img class="block width-100%" src="{{ asset('build/images/photos-galerie-1.jpg') }}" alt="Image description">
				</li>

				<li class="col-8@md col-6@lg offset-2@lg reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
					<img class="block width-100%" src="{{ asset('build/images/photos-galerie-2.jpg') }}" alt="Image description">
				</li>

				<li class="col-4@md reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
					<img class="block width-100%" src="{{ asset('build/images/photos-galerie-3.jpg') }}" alt="Image description">
				</li>

				<li class="col-4@md reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
					<img class="block width-100%" src="{{ asset('build/images/photos-galerie-6.png') }}" alt="Image description">
				</li>

				<li class="col-7@md col-6@lg reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
					<img class="block width-100%" src="{{ asset('build/images/photos-galerie-5.jpg') }}" alt="Image description">
				</li>

				<li class="col-10@md offset-1@md col-8@lg offset-2@lg reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
					<img class="block width-100%" src="{{ asset('build/images/photos-galerie-4.jpg') }}" alt="Image description">
				</li>
			</ul>
		</div>
	</section>
</div>{% endblock %}
