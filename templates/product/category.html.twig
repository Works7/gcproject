{% extends "base.html.twig" %}

{% block title %}
	{{ category.name }}
	| Ganache &amp; Cabosse
{% endblock %}

{% block body %}
	<!-- intro -->
	<section class="position-relative z-index-1" data-theme="light-1">
		<div class="container max-width-adaptive-lg padding-y-xl position-relative z-index-2">
			<div class="text-center">
				<h1 class="text-xxxl text-uppercase">{{ category.name }}</h1>
			</div>
		</div>

		<figure class="bg-decoration-v2 z-index-1 blend-overlay flip-y" aria-hidden="true">
			<svg class="bg-decoration-v2__svg color-contrast-higher opacity-30%" viewbox="0 0 1920 450" fill="none">
				<g stroke="currentColor" stroke-width="2">
					<path d="M1664 16H1466L1664 214V16Z"/>
					<circle cx="1565" cy="115" r="59"/>
				</g>
			</svg>
		</figure>
	</section>

	<!-- products -->
	<section class="position-relative z-index-1 padding-top-xxl padding-bottom-xxl">
		<div class="container max-width-adaptive-lg">
			<div class="margin-bottom-md">
				<nav class="breadcrumbs text-sm" aria-label="Breadcrumbs">
					<ol class="flex flex-wrap gap-xxs">
						<li class="breadcrumbs__item">
							<a href="{{ path('homepage') }}" class="color-inherit">Accueil</a>
							<svg class="icon margin-left-xxxs color-contrast-medium" aria-hidden="true" viewbox="0 0 16 16">
								<g stroke-width="1" stroke="currentColor">
									<polyline fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" points="6.5,3.5 11,8 6.5,12.5 "></polyline>
								</g>
							</svg>
						</li>
						<li class="breadcrumbs__item" aria-current="page">{{ category.name }}</li>
					</li>
				</ol>
			</nav>
		</div>

		<ul class="grid gap-sm">
			{% for p in category.products %}
				<li class="col6@xs col-4@sm col-3@md">
					<div class="prod-card-v2">
						<a href="{{ path('product_show', {'category_slug': p.category.slug, 'slug': p.slug}) }}" class="prod-card-v2__img-link" aria-label="Description of the link">
							<figure class="media-wrapper media-wrapper--4:5">
								<img src="assets/img/product-card-v2-img-1a.jpg" alt="Product preview image">
							</figure>
						</a>

						<div class="padding-sm text-center">
							<h2 class="text-md font-primary">
								<a href="{{ path('product_show', {'category_slug': p.category.slug, 'slug': p.slug}) }}" class="product-card-v2__title">{{ p.name }}</a>
							</h2>
						</div>
					</div>
				</li>
			{% endfor %}
		</ul>
	</div>
</section>{% endblock %}
