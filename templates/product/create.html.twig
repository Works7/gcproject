{% extends "base.html.twig" %}

{% form_theme formView _self %}

{% block title %}
	Création d'un produit
{% endblock %}

{% block body %}
	<div class="container max-width-adaptive-lg margin-top-lg margin-bottom-lg">
		<fieldset class="margin-bottom-md">
			<legend class="form-legend">Création d'un produit</legend>
			{{ form_start(formView) }}

			{{ form_errors(formView) }}

			<div class="grid gap-sm">
				{{ form_row(formView.name) }}
				{{ form_row(formView.price) }}
				{{ form_row(formView.category) }}
				{{ form_row(formView.details) }}
				{{ form_row(formView.mainPicture) }}
			</div>

			<div>
				<button type="submit" class="btn btn--primary margin-top-md">Créer le produit</button>
			</div>

			{{ form_end(formView) }}
		</fieldset>
	</div>
{% endblock %}

{% block form_row %}
	<div class="form-group">
		{{ form_label(form) }}
		{{ form_widget(form, {'attr': {'class': 'form-control width-100%'} }) }}
		{{ form_help(form) }}
		{{ form_errors(form) }}
	</div>
{% endblock %}
