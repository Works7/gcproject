{% extends "base.html.twig" %}

{% block title %}
	Création d'un produit
{% endblock %}

{% block body %}
	<div class="container max-width-adaptive-lg margin-top-lg margin-bottom-lg">
		<fieldset class="margin-bottom-md">
			<legend class="form-legend">Création d'un produit</legend>
			{{ form_start(formView) }}

			{{ form_errors(formView) }}

			<div class="grid gap-sm">
				{{ form_label(formView.name) }}
				{{ form_widget(formView.name, {'attr': {'class': 'form-control width-100%'} }) }}

				{{ form_label(formView.price) }}
				{{ form_widget(formView.price, {'attr': {'class': 'form-control width-100%'} }) }}

				{{ form_label(formView.category) }}
				{{ form_widget(formView.category, {'attr': {'class': 'form-control width-100%'} }) }}

				{{ form_label(formView.details) }}
				{{ form_widget(formView.details, {'attr': {'class': 'form-control width-100%'} }) }}

				{{ form_label(formView.mainPicture) }}
				{{ form_widget(formView.mainPicture, {'attr': {'class': 'form-control width-100%'} }) }}
			</div>

			<div>
				<button type="submit" class="btn btn--primary margin-top-md">Créer le produit</button>
			</div>

			{{ form_end(formView) }}
		</fieldset>
	</div>
{% endblock %}
