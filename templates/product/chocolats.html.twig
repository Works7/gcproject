{% extends "base.html.twig" %}

{% block title %}
	Chocolats | Ganache &amp; Cabosse | Rethel
{% endblock %}

{% block body %}
	<section class="padding-top-header position-relative z-index-1" data-theme="default">
		<div class="container max-width-adaptive-lg padding-top-lg padding-bottom-xl position-relative z-index-2">
			<div class="text-center">
				<h1 class="text-xxxl text-uppercase">Chocolats</h1>
			</div>
		</div>
	</section>
	
	<!-- categories -->
	<section class="position-relative z-index-1 padding-top-lg padding-bottom-lg">
		<div class="container max-width-adaptive-lg">
			<div class="margin-bottom-md">
				<nav class="breadcrumbs text-sm" aria-label="Breadcrumbs">
					<ol class="flex flex-wrap gap-xxs">
						<li class="breadcrumbs__item">
							<a href="{{ path('homepage') }}" class="color-inherit">Accueil</a>
							<svg class="icon margin-left-xxxs color-contrast-medium" aria-hidden="true" viewbox="0 0 16 16">
								<g stroke-width="1" stroke="currentColor">
									<polyline fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" points="6.5,3.5 11,8 6.5,12.5 "></polyline>
								</g>
							</svg>
						</li>
						<li class="breadcrumbs__item" aria-current="page">Chocolats</li>
					</li>
				</ol>
			</nav>
		</div>

		<div class="grid gap-sm">

			<a class="card-v2 radius-md col-3@md" href="{{ path('product_category', {'slug' : 'ballotins-de-chocolats'}) }}">
				<figure>
					<img src="{{ asset('build/images/chocolat-ballotins-chocolat.jpg') }}" alt="Image description">
					<figcaption class="card-v2__caption padding-x-sm padding-top-md padding-bottom-sm text-center">
						<div class="text-md text-base@md">Ballotins de chocolats</div>
					</figcaption>
				</figure>
			</a>

			<a class="card-v2 radius-md col-3@md" href="{{ path('product_category', {'slug' : 'tablettes-de-chocolat'}) }}">
				<figure>
					<img src="{{ asset('build/images/chocolat-tablettes.jpg') }}" alt="Image description">
					<figcaption class="card-v2__caption padding-x-sm padding-top-md padding-bottom-sm text-center">
						<div class="text-md text-base@md">Tablettes de chocolat</div>
					</figcaption>
				</figure>
			</a>

			<a class="card-v2 radius-md col-3@md" href="{{ path('product_category', {'slug' : 'specialites-en-chocolat'}) }}">
				<figure>
					<img src="{{ asset('build/images/chocolat-specialites.jpg') }}" alt="Image description">
					<figcaption class="card-v2__caption padding-x-sm padding-top-md padding-bottom-sm text-center">
						<div class="text-md text-base@md">Spécialités en chocolat</div>
					</figcaption>
				</figure>
			</a>

			<a class="card-v2 radius-md col-3@md" href="{{ path('product_category', {'slug' : 'moulages'}) }}">
				<figure>
					<img src="{{ asset('build/images/chocolat-moulages.jpg') }}" alt="Image description">
					<figcaption class="card-v2__caption padding-x-sm padding-top-md padding-bottom-sm text-center">
						<div class="text-md text-base@md">Moulages</div>
					</figcaption>
				</figure>
			</a>
		</div>
	</section>
{% endblock %}

{% block footer %}
	{% include '_partials/footer.html.twig' %}
{% endblock %}
