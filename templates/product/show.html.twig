{% extends "base.html.twig" %}

{% block title %}
	{{ product.name }}
	|
	{{ product.category.name }}
	| Ganache &amp; Cabosse
{% endblock %}

{% block body %}
	<main
		class="position-relative z-index-1">
		<!-- product -->
		<section class="product-v3 padding-top-lg padding-bottom-xl js-product-v3" data-theme="dark-1">
			<div class="container max-width-adaptive-lg">
				<div class="margin-bottom-md">
					<nav class="breadcrumbs text-sm" aria-label="Breadcrumbs">
						<ol class="flex flex-wrap gap-xxs">
							<li class="breadcrumbs__item">
								<a href="{{ path('homepage') }}" class="color-inherit">Accueil</a>
								<svg class="icon margin-left-xxxs color-contrast-medium" aria-hidden="true" viewbox="0 0 16 16">
									<g stroke-width="1" stroke="currentColor">
										<polyline fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" points="6.5,3.5 11,8 6.5,12.5 "></polyline>
									</g>
								</svg>
							</li>

							<li class="breadcrumbs__item">
								<a href="{{ path('product_category', {'slug' : product.category.slug}) }}" class="color-inherit">{{ product.category.name }}</a>
								<svg class="icon margin-left-xxxs color-contrast-medium" aria-hidden="true" viewbox="0 0 16 16">
									<g stroke-width="1" stroke="currentColor">
										<polyline fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-miterlimit="10" points="6.5,3.5 11,8 6.5,12.5 "></polyline>
									</g>
								</svg>
							</li>

							<li class="breadcrumbs__item" aria-current="page">{{ product.name }}</li>
						</ol>
					</nav>
				</div>

				<div class="grid gap-md">
					<div class="col-6@md col-7@lg">
						<div class="flex flex-column gap-sm">
							<figure class="flex-shrink-0">
								<img class="block width-100%" src="{{ product.mainPicture }}" alt="Image description">
							</figure>

							<figure class="flex-shrink-0">
								<img class="block width-100%" src="{{ product.mainPicture }}" loading="lazy" alt="Image description">
							</figure>

							<figure class="flex-shrink-0">
								<img class="block width-100%" src="{{ product.mainPicture }}" loading="lazy" alt="Image description">
							</figure>
						</div>
					</div>

					<div class="col-6@md col-5@lg">
						<div class="product-v3__panel">
							<div class="margin-bottom-xs">
								<h1>{{ product.name }}</h1>
							</div>

							<div class="text-component margin-bottom-md">
								<p>{{ product.details }}</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- related products -->
		<section class="padding-y-xl">
			<div class="container max-width-adaptive-lg">
				<div class="margin-bottom-lg">
					<h1 class="text-md">Découvrez aussi</h1>
				</div>
			</div>

			<div class="overflow-hidden">
				<div class="carousel carousel-v3 flex flex-column container max-width-lg js-carousel" data-drag="on" data-loop="off" data-overflow-items="on" data-align-controls=".prod-card-v2__img-link">
					<p class="sr-only">Carousel items</p>

					<div class="carousel__wrapper position-relative">
						<ol class="carousel__list">
							<li class="carousel__item">
								<div class="prod-card-v2">
									<a href="#0" class="prod-card-v2__img-link" aria-label="Description of the link">
										<figure class="media-wrapper media-wrapper--4:5">
											<img src="assets/img/product-card-v2-img-1a.jpg" alt="Product preview image">
										</figure>
									</a>

									<div class="padding-sm text-center">
										<h2 class="text-md font-primary">
											<a href="#0" class="product-card-v2__title">{{ product.name }}</a>
										</h2>
									</div>
								</div>
							</li>
						</ol>

						<nav class="no-js:is-hidden">
							<ul class="position-absolute top-0 left-0 bottom-0 right-0 pointer-events-none flex items-center justify-between">
								<li>
									<button class="reset carousel-v3__control carousel-v3__control--prev js-carousel__control js-tab-focus">
										<svg class="icon icon--xs" viewbox="0 0 16 16">
											<title>Show previous items</title>
											<g>
												<path d="M10.892,16.41L4.241,8.65c-0.321-0.374-0.321-0.927,0-1.301l6.651-7.76l1.519,1.302L6.317,8l6.093,7.108 L10.892,16.41z"></path>
											</g>
										</svg>
									</button>
								</li>

								<li>
									<button class="reset carousel-v3__control carousel-v3__control--next js-carousel__control js-tab-focus">
										<svg class="icon icon--xs" viewbox="0 0 16 16">
											<title>Show next items</title>
											<g>
												<path d="M5.108,16.41L3.59,15.108L9.683,8L3.59,0.892L5.108-0.41l6.651,7.76c0.321,0.374,0.321,0.927,0,1.301 L5.108,16.41z"></path>
											</g>
										</svg>
									</button>
								</li>
							</ul>
						</nav>
					</div>
				</div>
			</div>
		</section>
	</main>
{% endblock %}
