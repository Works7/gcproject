{% extends "base.html.twig" %}

{% block title %}
	Ganache &amp; Cabosse | Pâtisserie Chocolaterie | Rethel
{% endblock %}

{% block body %}
	<!-- intro -->
	<section class="feature-v9 margin-bottom-xxl" data-theme="dark">
		<div class="grid">
			<div class="feature-v9__block col-12@md" style="background-image: url('{{ asset('build/images/accueil-calendrier.jpg') }}');">
				<div class="feature-v9__content text-component text-center max-width-xxxs">
				<div class="ie:bg ie:padding-md">
					<h2 class="text-xxxl color-white">Calendriers de l'Avent</h2>
					{# <p class="opacity-90% color-white">Boooo !</p> #}
					{# <p><a class="feature-v9__link" href="{{ path('product_category', {'slug' : 'halloween'}) }}"></a></p> #}
				</div>
				</div>
			</div>
		</div>
	</section>

	<!-- latest products -->
	<section class="position-relative z-index-1 margin-bottom-xxl">
		<div class="container max-width-adaptive-md margin-bottom-xl">
			<div class="grid gap-sm">
				<div class="margin-bottom-sm@md">
					<h1 class="text-xxl text-center">Notre sélection</h1>
				</div>
			</div>
    	</div>

		<div class="overflow-hidden reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="50">
			<div class="carousel carousel-v3 flex flex-column container max-width-md js-carousel" data-drag="on" data-loop="off" data-overflow-items="on" data-align-controls=".prod-card-v2__img-link">
				<p class="sr-only">Carousel items</p>

				<div class="carousel__wrapper position-relative">
					<ol class="carousel__list">
						{% for p in products %}
							<li class="carousel__item">
								<div class="prod-card-v2">
									<a href="{{ path('product_show', {'category_slug': p.category.slug, 'slug': p.slug}) }}" class="prod-card-v2__img-link" aria-label="Description of the link">
										<figure class="media-wrapper media-wrapper--4:5">
											<img src="/uploads/{{ p.mainPicture }}" alt="Sélection | {{ p.name }} | Ganache &amp; Cabosse">
										</figure>
									</a>

									<div class="padding-sm text-center">
										<h2 class="text-md font-primary">
											<a href="{{ path('product_show', {'category_slug': p.category.slug, 'slug': p.slug}) }}" class="product-card-v2__title">{{ p.name }}</a>
										</h2>
									</div>
								</div>
							</li>
						{% endfor %}
					</ol>

					<nav class="no-js:is-hidden">
						<ul class="position-absolute top-0 left-0 bottom-0 right-0 pointer-events-none flex items-center justify-between">
							<li>
								<button class="reset carousel-v3__control carousel-v3__control--prev js-carousel__control js-tab-focus">
									<svg class="icon icon--xs" viewbox="0 0 16 16">
										<title>Précédent</title>
										<g>
											<path d="M10.892,16.41L4.241,8.65c-0.321-0.374-0.321-0.927,0-1.301l6.651-7.76l1.519,1.302L6.317,8l6.093,7.108 L10.892,16.41z"></path>
										</g>
									</svg>
								</button>
							</li>

							<li>
								<button class="reset carousel-v3__control carousel-v3__control--next js-carousel__control js-tab-focus">
									<svg class="icon icon--xs" viewbox="0 0 16 16">
										<title>Suivant</title>
										<g>
											<path d="M5.108,16.41L3.59,15.108L9.683,8L3.59,0.892L5.108-0.41l6.651,7.76c0.321,0.374,0.321,0.927,0,1.301 L5.108,16.41z"></path>
										</g>
									</svg>
								</button>
							</li>
						</ul>
					</nav>
				</div>
			</div>
		</div>
	</section>

	<!-- categories -->
	<section class="position-relative z-index-1 margin-bottom-xxl">
		<div class="container max-width-xs margin-bottom-xl">
			<div class="text-component text-center">
				<h1 class="text-xxl">Nos produits</h1>
			</div>
		</div>

		<div class="container max-width-adaptive-md">
			<div class="grid gap-sm">
				<div>
				<div class="banner overflow-hidden">
					<a href="{{ path('product_category', {'slug' : 'patisseries'}) }}" class="text-decoration-none" aria-label="Découvrir">
					<div class="grid flex-row-reverse@md">
						<div class="col-6@md overflow-hidden" aria-hidden="true">
						<div class="banner__figure width-100%" style="background-image: url('{{ asset('build/images/accueil-patisseries.jpg') }}');">
						</div>
						</div>

						<div class="col-6@md">
						<div class="text-component v-space-md height-100% flex flex-column padding-md padding-lg@md">
							<h2>Pâtisseries</h2>
							<p class="margin-top-sm margin-top-lg@md"><span class="banner__link"><i>Découvrir</i></span></p>
						</div>
						</div>
					</div>
					</a>
				</div>
				</div>

				<div>
				<div class="banner overflow-hidden">
					<a href="/chocolats" class="text-decoration-none" aria-label="Découvrir">
					<div class="grid flex-row-reverse@md">
						<div class="col-6@md overflow-hidden" aria-hidden="true">
						<div class="banner__figure width-100%" style="background-image: url('{{ asset('build/images/intro-2.jpg') }}');">
						</div>
						</div>

						<div class="col-6@md">
						<div class="text-component v-space-md height-100% flex flex-column padding-md padding-lg@md">
							<h2>Chocolats</h2>
							<p class="margin-top-sm margin-top-lg@md"><span class="banner__link"><i>Découvrir</i></span></p>
						</div>
						</div>
					</div>
					</a>
				</div>
				</div>

				<div>
				<div class="banner overflow-hidden">
					<a href="{{ path('product_category', {'slug' : 'macarons'}) }}" class="text-decoration-none" aria-label="Découvrir">
					<div class="grid flex-row-reverse@md">
						<div class="col-6@md overflow-hidden" aria-hidden="true">
						<div class="banner__figure width-100%" style="background-image: url('{{ asset('build/images/intro-1.jpg') }}');">
						</div>
						</div>

						<div class="col-6@md">
						<div class="text-component v-space-md height-100% flex flex-column padding-md padding-lg@md">
							<h2>Macarons</h2>
							<p class="margin-top-sm margin-top-lg@md"><span class="banner__link"><i>Découvrir</i></span></p>
						</div>
						</div>
					</div>
					</a>
				</div>
				</div>
			</div>
    	</div>
	</section>

	<!-- stores -->
	<section class="feature-v8 padding-bottom-lg bg-transparent">
		<div class="feature-v8__main-content bg-contrast-lower padding-top-xxl margin-top-x">
			<div class="container max-width-adaptive-md">
				<div class="grid gap-sm gap-lg@sm">
					<div class="text-component text-center col-12@sm">
						<h1 class="text-xxl color-primary">Notre boutique</h1>
					</div>
				</div>
			</div>
		</div>

		<div class="container max-width-adaptive-md">
			<ul class="feature-v8__sub-content grid gap-lg">
				<li class="col-6@sm reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
					<a href="#0" class="card-v8 bg" data-theme="default">
						<figure>
							<img src="{{ asset('build/images/accueil-boutique-1.jpg') }}" loading="lazy" alt="Boutique | Ganache &amp; Cabosse">
						</figure>
					</a>
				</li>

				<li class="col-6@sm reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100" data-reveal-fx-delay="100">
					<a href="#0" class="card-v8 bg" data-theme="default">
						<figure>
							<img src="{{ asset('build/images/accueil-boutique-2.jpg') }}" loading="lazy" alt="Boutique | Ganache &amp; Cabosse">
						</figure>
					</a>
				</li>
			</ul>
		</div>
	</section>
{% endblock %}

{% block footer %}
	{% include '_partials/footer-leader.html.twig' %}
{% endblock %}
