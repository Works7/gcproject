{% extends "base.html.twig" %}

{% block title %}
	Photos | Ganache &amp; Cabosse
{% endblock %}

{% block body %}
	<section class="contact-v2 padding-top-xl margin-bottom-xxl">
		<div class="container max-width-lg margin-bottom-lg">
			<div class="adv-gallery-v3">
				<ul class="grid gap-xs">
					<li class="col-4@md col-3@lg">
						<p class="adv-gallery-v3__title">Galerie Photo</p>
					</li>

					<li class="col-8@md col-6@lg reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
						<img class="block width-100%" src="http://placehold.it/400x700" alt="Image description">
					</li>

					<li class="col-8@md col-6@lg offset-2@lg reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
						<img class="block width-100%" src="http://placehold.it/200x400" alt="Image description">
					</li>

					<li class="col-4@md reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
						<img class="block width-100%" src="http://placehold.it/500x500" alt="Image description">
					</li>

					<li class="col-4@md reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
						<img class="block width-100%" src="http://placehold.it/100x100" alt="Image description">
					</li>

					<li class="col-7@md col-6@lg reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
						<img class="block width-100%" src="http://placehold.it/300x500" alt="Image description">
					</li>

					<li class="col-10@md offset-1@md col-8@lg offset-2@lg reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
						<img class="block width-100%" src="http://placehold.it/500x700" alt="Image description">
					</li>

					<li class="col-3@md offset-1@lg reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
						<img class="block width-100%" src="http://placehold.it/300x300" alt="Image description">
					</li>

					<li class="col-9@md col-8@lg reveal-fx reveal-fx--translate-up" data-reveal-fx-delta="100">
						<img class="block width-100%" src="http://placehold.it/400x100" alt="Image description">
					</li>
				</ul>
			</div>
		</section>
	</div>
{% endblock %}
