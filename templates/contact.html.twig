{% extends "base.html.twig" %}

{% block title %}
	Contact | Ganache &amp; Cabosse | Rethel
{% endblock %}

{% block body %}

	<section class="contact-v2 padding-top-xl margin-bottom-xxl">
		<div class="container max-width-xs margin-bottom-lg">
			<div class="text-component text-center">
				<h1 class="text-xxxl">Contact Us</h1>
				<p>Lorem ipsum dolor, sit amet consectetur adipisicing elit. Ducimus eos impedit nesciunt voluptates magni vero itaque.</p>
			</div>
		</div>

		<div class="container max-width-lg">
			<dl class="details-list-v2 details-list-v2--cols margin-bottom-lg">
				<div class="details-list-v2__item">
					<dt class="details-list-v2__dt">Address</dt>
					<dd class="details-list-v2__dd">
						86  Whitby Road
						<br>IP20 6JA
						<br>London, UK
					</dd>
				</div>

				<div class="details-list-v2__item">
					<dt class="details-list-v2__dt">Email</dt>
					<dd class="details-list-v2__dd">
						<a href='mailto:webmaster@example.com'>hello@myemail.com</a>
					</dd>
				</div>

				<div class="details-list-v2__item">
					<dt class="details-list-v2__dt">Phone</dt>
					<dd class="details-list-v2__dd">
						<a href='tel:+44 7656 6455'>+44 7656 6455</a>
						<br><small class='color-contrast-medium'>Mon - Fri, 9AM - 5PM</small>
					</dd>
				</div>
			</dl>

			<div role="application" class="google-maps google-maps--ratio-3:1 js-google-maps" data-coordinates="51.5658015,-0.40339"><!-- Google Map --></div>
		</div>
	</section>
	<!-- 
							    ⚠️ Make sure to include the Google Maps script right before your page body closing tag
							    <script async defer src="https://maps.googleapis.com/maps/api/js?key=YOUR_API_KEY&callback=initGoogleMap"></script> 
							    Replace 'YOUR_API_KEY' with your google maps API key
							  -->

{% endblock %}
