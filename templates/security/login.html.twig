{% extends 'base.html.twig' %}

{% block title %}Connexion
{% endblock %}

{% block body %}
	<div class="container max-width-adaptive-lg margin-top-lg margin-bottom-lg">
		<fieldset class="margin-bottom-md">
			<legend class="form-legend">Connexion</legend>
			{% if error %}
				{{ error.message }}
			{% endif %}

			{{ form_start(formView) }}

			<div class="grid gap-sm">
				{{ form_label(formView.email) }}
				{{ form_widget(formView.email, {'attr': {'class': 'form-control width-100%'} }) }}

				{{ form_label(formView.password) }}
				{{ form_widget(formView.password, {'attr': {'class': 'form-control width-100%'} }) }}
			</div>

			<div>
				<button type="submit" class="btn btn--primary margin-top-md">Connexion</button>
			</div>

			{{ form_end(formView) }}
		</fieldset>
	</div>
{% endblock %}
